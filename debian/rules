#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
export DH_VERBOSE = 1


# see FEATURE AREAS in dpkg-buildflags(1)
# Qt requires the program to be position independent, otherwise signals are
# not found when Qt is linked with -Bsymbolic-functions (as in Ubuntu)
export DEB_BUILD_MAINT_OPTIONS = hardening=-all,+pie optimize=-lto

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
export DEB_CXXFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
	dh $@ --buildsystem=cmake


# dh_make generated override targets

# Build the 32-bit library on amd64, it is packaged separately in libtas32
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),amd64)
CONFIGURE_ARGS += -DLIBTAS_BUILD_I386=ON
endif

override_dh_auto_configure:
	dh_auto_configure -- $(CONFIGURE_ARGS)

# On amd64, also ship the steam_api.dll replacements used by Wine games with
# the virtual Steam client (built with mingw-w64)
ifeq ($(DEB_HOST_ARCH),amd64)
override_dh_install:
	dh_install
	dh_install -plibtas usr/bin/libtas-steam_api.dll usr/bin/libtas-steam_api64.dll usr/bin
endif

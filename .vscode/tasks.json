{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "cmake configure",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "build",
				"-DCMAKE_CXX_FLAGS=-Og -g -Wall -pedantic"
			],
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "configure and build",
			"command": "cmake",
			"args": [
				"--build", "build",
				"-j4"
			],
			"problemMatcher": [
				"$gcc"
			],
			"dependsOrder": "sequence",
			"dependsOn": ["cmake configure"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
		},
		{
			"type": "shell",
			"label": "build",
			"command": "cmake",
			"args": [
				"--build", "build",
				"-j4"
			],
			"problemMatcher": [
				"$gcc"
			],
            "group": {
                "kind": "build",
                "isDefault": true
            }
		},
		{
			"type": "shell",
			"label": "clean",
			"command": "cmake",
			"args": [
				"--build", "build",
				"--target", "clean"
			],
			"problemMatcher": []
		}
	]
}
